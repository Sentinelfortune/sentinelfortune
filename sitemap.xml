---
layout: null
---
{%- comment -%}
Hand-rolled rather than plugin-generated so the ready-status filter is
enforced here too: content that has not passed the editorial gate is never
advertised to a crawler.
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ '/' | absolute_url }}</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ '/shop/' | absolute_url }}</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
{%- comment -%}
  Explicit, not derived from site.collections: the signals collection is
  published at /updates/, so a label-derived loop would advertise a URL that
  does not exist.
{%- endcomment -%}
{%- assign hubs = "/products/,/articles/,/guides/,/updates/,/about/,/faq/,/contact/" | split: "," %}
{%- for h in hubs %}
  <url>
    <loc>{{ h | absolute_url }}</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
{%- endfor %}
{%- assign ready = site.signals | concat: site.articles | concat: site.guides | where: "status", "ready" -%}
{%- for item in ready %}
  <url>
    <loc>{{ item.url | absolute_url }}</loc>
    <lastmod>{{ item.updated | default: item.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
{%- endfor %}
{%- comment -%}
  The storefront's legal and support pages carry no front matter, so Jekyll
  treats them as static files and they never appear in site.pages — a loop
  over site.pages silently emitted nothing for them. Listed explicitly.

  product.html, success.html and cancelled.html are omitted on purpose: they
  render nothing without a query string, so indexing them would put three
  empty pages in the index.
{%- endcomment -%}
{%- assign shop_pages = "licenses.html,refund-policy.html,terms-of-sale.html,privacy.html,contact.html" | split: "," %}
{%- for sp in shop_pages %}
  <url>
    <loc>{{ '/shop/' | append: sp | absolute_url }}</loc>
    <changefreq>yearly</changefreq>
    <priority>0.4</priority>
  </url>
{%- endfor %}
</urlset>
