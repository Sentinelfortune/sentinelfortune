{
  "name": "sentinel-fortune-shop-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated Cloudflare Worker backend for the Sentinel Fortune LLC Digital Shop MVP.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply sentinel-fortune-shop --local",
    "db:migrate:remote": "wrangler d1 migrations apply sentinel-fortune-shop --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.0.0"
  }
}
